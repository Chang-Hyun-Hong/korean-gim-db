---
import type { Locale } from '../i18n/utils';
import { localizedPath, useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

// 언어 토글: 현재 locale의 반대 언어로 가는 링크
const otherLocale: Locale = locale === 'en' ? 'ko' : 'en';
const otherLabel = otherLocale === 'en' ? 'English' : '한국어';
const otherHref = localizedPath(otherLocale, '/');
---
<header class="sticky top-0 z-50 border-b border-border/60 bg-bg-primary/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href={localizedPath(locale, '/')} class="font-serif text-xl font-medium tracking-tight text-text-primary hover:text-kelp transition-colors">
      {t('site.title')}
    </a>
    <nav class="flex items-center gap-2 text-sm">
      <a
        href={otherHref}
        class="px-3 py-1.5 rounded-sm text-text-secondary hover:text-kelp hover:bg-bg-secondary transition-colors"
        aria-label={`Switch to ${otherLabel}`}
      >
        {otherLabel}
      </a>
    </nav>
  </div>
</header>
