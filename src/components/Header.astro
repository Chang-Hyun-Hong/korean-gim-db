---
import { getCollection } from 'astro:content';
import type { Locale } from '../i18n/utils';
import { localizedPath, useTranslations } from '../i18n/utils';
import MegaMenu from './MegaMenu.astro';
import MobileNavToggle from './MobileNavToggle.astro';
import MobileNavPanel from './MobileNavPanel.astro';

interface Props {
  locale: Locale;
  /** 현재 경로에 대응하는 다른 로케일 페이지가 없을 때(404 등) 전환 대상을 직접 지정 */
  localeSwitchPath?: string;
}
const { locale, localeSwitchPath } = Astro.props;
const t = useTranslations(locale);

const otherLocale: Locale = locale === 'en' ? 'ko' : 'en';
const otherLocaleLabel = otherLocale === 'en' ? 'English' : '한국어';

const all = await getCollection('articles', (e) => !e.data.draft);
const localePrefix = `${locale}/`;
const localized = all.filter((e) => e.id.startsWith(localePrefix));
const sorted = localized.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
const slugOf = (id: string) => id.replace(localePrefix, '').replace(/\.md$/, '');
const pickLatest = (cat: 'news' | 'recipe') => {
  const e = sorted.find((x) => x.data.category === cat);
  return e ? { slug: slugOf(e.id), title: e.data.title } : null;
};
const latestNews = pickLatest('news');
const latestRecipe = pickLatest('recipe');

// 현재 페이지 판별 — 하위 경로(/articles/foo)도 상위 항목(/articles)을 활성으로 본다
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  return currentPath === h || (h !== '/' && currentPath.startsWith(`${h}/`));
};

// 언어 전환은 같은 페이지의 다른 로케일 판으로 간다 (예: /reviews ↔ /ko/reviews).
// 404처럼 짝이 없는 페이지는 페이지 쪽에서 localeSwitchPath로 대상을 지정한다.
const basePath = localeSwitchPath ?? (currentPath.replace(/^\/ko(?=\/|$)/, '') || '/');
const otherLocaleHref = localizedPath(otherLocale, basePath);

const aboutHref = localizedPath(locale, '/what-is-gim');
const guidesHref = localizedPath(locale, '/buying-guide');
const articlesNavHref = localizedPath(locale, '/articles');
const reviewsHref = localizedPath(locale, '/reviews');

const navItems = [
  { href: aboutHref, label: t('nav.about') },
  { href: guidesHref, label: t('nav.guides') },
  { href: articlesNavHref, label: t('nav.articles') },
  { href: reviewsHref, label: t('nav.reviews') },
].map((item) => ({ ...item, active: isActive(item.href) }));

// 데스크톱 링크 공통 클래스 (활성 상태는 색 + 굵기로 표시)
const navLink = (active: boolean) => [
  'block px-3 py-1.5 rounded-sm transition-colors',
  active
    ? 'text-kelp font-medium bg-bg-secondary'
    : 'text-text-secondary hover:text-kelp hover:bg-bg-secondary',
];
---
<header class="sticky top-0 z-40 border-b border-border/60 bg-bg-primary/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between gap-4">
    <a
      href={localizedPath(locale, '/')}
      class="font-serif text-xl font-medium tracking-tight text-text-primary hover:text-kelp transition-colors shrink-0"
    >
      {t('site.title')}
    </a>

    <nav class="hidden md:flex items-center gap-1 text-sm" aria-label="Primary">
      <ul class="flex items-center gap-1" data-desktop-nav>
        <li>
          <a
            href={aboutHref}
            aria-current={isActive(aboutHref) ? 'page' : undefined}
            class:list={navLink(isActive(aboutHref))}
          >
            {t('nav.about')}
          </a>
        </li>
        <li>
          <a
            href={guidesHref}
            aria-current={isActive(guidesHref) ? 'page' : undefined}
            class:list={navLink(isActive(guidesHref))}
          >
            {t('nav.guides')}
          </a>
        </li>
        <MegaMenu
          locale={locale}
          latestNews={latestNews}
          latestRecipe={latestRecipe}
          active={isActive(articlesNavHref)}
        />
        <li>
          <a
            href={reviewsHref}
            aria-current={isActive(reviewsHref) ? 'page' : undefined}
            class:list={navLink(isActive(reviewsHref))}
          >
            {t('nav.reviews')}
          </a>
        </li>
      </ul>
      <span class="inline-block w-px h-5 bg-border mx-1" aria-hidden="true"></span>
      <a
        href={otherLocaleHref}
        class="px-3 py-1.5 rounded-sm text-text-secondary hover:text-kelp hover:bg-bg-secondary transition-colors"
        aria-label={`Switch to ${otherLocaleLabel}`}
      >
        {otherLocaleLabel}
      </a>
    </nav>

    <MobileNavToggle locale={locale} />
  </div>
</header>

<MobileNavPanel
  locale={locale}
  navItems={navItems}
  otherLocaleHref={otherLocaleHref}
  otherLocaleLabel={otherLocaleLabel}
/>

<script>
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const active = document.activeElement as HTMLElement | null;
    const inMega = active?.closest('[data-mega]');
    if (inMega && active && 'blur' in active) active.blur();
  });
</script>
