---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Pick {
  name: string;
  name_en?: string;
  review: string;
  review_en?: string;
  type: string;
  link: string;
}

interface Props {
  locale: Locale;
  picks: Pick[];
}
const { locale, picks } = Astro.props;
const t = useTranslations(locale);

function displayName(p: Pick): string {
  if (locale === 'en') return p.name_en || p.name;
  return p.name;
}
function displayReview(p: Pick): string {
  if (locale === 'en') return p.review_en || p.review;
  return p.review;
}
function displayType(p: Pick): string {
  return t(`type_labels.${p.type}`) || p.type;
}

const heading = locale === 'en' ? "Editor's Picks" : '에디터 추천';
const sub = locale === 'en'
  ? 'A handful of gim worth trying first.'
  : '먼저 시도해볼 만한 김 몇 가지.';
---
<section class="max-w-7xl mx-auto px-6 mt-16">
  <div class="flex items-baseline justify-between mb-6">
    <div>
      <h2 class="text-h2 font-serif font-medium text-text-primary tracking-tight">{heading}</h2>
      <p class="text-text-secondary mt-1 text-sm">{sub}</p>
    </div>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {picks.map(p => (
      <a
        href={p.link || '#'}
        target={p.link ? '_blank' : undefined}
        rel={p.link ? 'noopener' : undefined}
        class="group relative block p-6 bg-bg-card border border-border rounded-lg overflow-hidden transition-all duration-300 hover:border-kelp/40 hover:shadow-md"
      >
        {/* dereknee-style 글로우: 카드 호버 시 우상단에서 부드러운 라이트 */}
        <span aria-hidden="true" class="pointer-events-none absolute -top-12 -right-12 w-40 h-40 rounded-full bg-seafoam/40 blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></span>
        <span class="relative inline-block text-xs font-medium uppercase tracking-wider text-kelp">{displayType(p)}</span>
        <h3 class="relative font-serif text-h3 font-medium text-text-primary mt-3 leading-snug">{displayName(p)}</h3>
        <p class="relative text-sm text-text-secondary mt-3 leading-relaxed line-clamp-3">{displayReview(p)}</p>
        <span class="relative inline-flex items-center gap-1.5 text-xs font-medium text-kelp mt-4 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          {t('table.buy')} <span aria-hidden="true">→</span>
        </span>
      </a>
    ))}
  </div>
</section>
