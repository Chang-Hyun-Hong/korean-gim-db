---
import Image from './Image.astro';

interface HighlightItem {
  image?: any;
  imageAlt?: string;
  imagePlaceholderLabel?: string;
  keyword: string;
  copy: string;
}

interface Props {
  heading?: string;
  items: HighlightItem[];
}

const { heading, items } = Astro.props;
---
<section class="px-6 py-20 bg-bg-primary">
  <div class="max-w-7xl mx-auto">
    {heading && (
      <h2 class="font-serif font-medium text-text-primary tracking-tight mb-12 text-h2">
        {heading}
      </h2>
    )}
    <div class="grid md:grid-cols-3 gap-8 md:gap-10">
      {items.map(item => (
        <article>
          <div class="rounded-md overflow-hidden mb-6 aspect-square">
            {item.image ? (
              <Image
                src={item.image}
                alt={item.imageAlt ?? ''}
                class="w-full h-full object-cover"
              />
            ) : (
              <div class="w-full h-full bg-seafoam-light/60 flex items-center justify-center text-text-muted text-sm border border-dashed border-kelp/30 text-center px-4">
                {item.imagePlaceholderLabel ?? 'Image — to be added'}
              </div>
            )}
          </div>
          <p class="text-text-primary leading-relaxed">
            <strong class="font-semibold">{item.keyword}</strong>
            {' '}
            {item.copy}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
