---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
  data: { type: string; cook: string }[];
}
const { locale, data } = Astro.props;
const t = useTranslations(locale);

// 옵션은 실제 데이터에서 뽑는다 — Notion에 새 종류가 추가돼도 필터에서 빠지지 않게.
// value는 데이터 원본(한글), label은 locale 사전(없으면 원본 그대로).
function options(values: string[], dict: 'type_labels' | 'cooking_labels') {
  const unique = [...new Set(values.filter(Boolean))].map((value) => ({
    value,
    label: t(`${dict}.${value}`, value),
  }));
  unique.sort((a, b) => a.label.localeCompare(b.label, locale));
  return [{ value: '', label: t('filter.all') }, ...unique];
}

const typeOptions = options(data.map((d) => d.type), 'type_labels');
const cookOptions = options(data.map((d) => d.cook), 'cooking_labels');
---
<section class="max-w-7xl mx-auto px-6 mt-8">
  <div
    data-filterbar
    class="flex flex-col sm:flex-row sm:items-end gap-4 py-4 px-5 bg-bg-card border border-border rounded-md shadow-sm"
  >
    <div class="flex flex-col gap-1.5 min-w-[10rem]">
      <label for="filterType" class="text-xs font-medium text-text-secondary uppercase tracking-wider">{t('filter.type_label')}</label>
      <select
        id="filterType"
        class="px-3 py-2 text-sm bg-bg-card border border-border-strong rounded-sm text-text-primary focus:border-kelp transition-colors"
      >
        {typeOptions.map(o => <option value={o.value}>{o.label}</option>)}
      </select>
    </div>
    <div class="flex flex-col gap-1.5 min-w-[10rem]">
      <label for="filterCook" class="text-xs font-medium text-text-secondary uppercase tracking-wider">{t('filter.cooking_label')}</label>
      <select
        id="filterCook"
        class="px-3 py-2 text-sm bg-bg-card border border-border-strong rounded-sm text-text-primary focus:border-kelp transition-colors"
      >
        {cookOptions.map(o => <option value={o.value}>{o.label}</option>)}
      </select>
    </div>
    <div class="flex flex-col gap-1.5 flex-1">
      <label for="searchInput" class="text-xs font-medium text-text-secondary uppercase tracking-wider">{t('filter.search_label')}</label>
      <input
        id="searchInput"
        type="text"
        placeholder={t('filter.search_placeholder')}
        class="px-3 py-2 text-sm bg-bg-card border border-border-strong rounded-sm text-text-primary placeholder:text-text-muted focus:border-kelp transition-colors"
      />
    </div>
  </div>
</section>
