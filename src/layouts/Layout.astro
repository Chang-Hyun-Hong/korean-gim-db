---
import '../styles/global.css';
import MetaTags from '../components/seo/MetaTags.astro';
import { useTranslations } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'ko';
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = '',
  lang = 'en',
  ogImage,
  type,
  noindex,
} = Astro.props;

const t = useTranslations(lang);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <MetaTags {title} {description} {ogImage} {type} locale={lang} {noindex} />
  {lang === 'ko' && (
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
  )}
  <slot name="head" />
</head>
<body>
  <a href="#main" class="skip-link">{t('nav.skip')}</a>
  <slot />
</body>
</html>
