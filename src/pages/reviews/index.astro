---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import FilterBar from '../../components/FilterBar.astro';
import EditorsPicks from '../../components/EditorsPicks.astro';
import ReviewTable from '../../components/ReviewTable.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations } from '../../i18n/utils';

const dataPath = resolve(process.cwd(), 'public/data.json');
const data = JSON.parse(readFileSync(dataPath, 'utf-8'));
// 평점 높은 순으로 3개. 원본 data는 아래 표에 그대로 쓰이므로 복사본을 정렬한다.
const picks = [...data].sort((a, b) => b.scoreNum - a.scoreNum).slice(0, 3);

const locale = 'en' as const;
const t = useTranslations(locale);
---
<Layout title={t('reviews_page.title')} description={t('reviews_page.meta_description')} lang={locale}>
  <Header locale={locale} />

  <main id="main" tabindex="-1">
    <section class="max-w-7xl mx-auto px-6 pt-16 pb-4">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div class="max-w-2xl">
          <p class="text-xs uppercase tracking-[0.2em] text-kelp font-medium mb-3">Korean GIM</p>
          <h1 class="font-serif font-medium text-text-primary leading-[1.05] tracking-tight" style="font-size: var(--text-display);">
            {t('site.title')}
          </h1>
          <p class="text-text-secondary mt-5 text-base leading-relaxed">{t('site.tagline')}</p>
        </div>
        <div class="flex flex-col items-start md:items-end shrink-0">
          <span class="font-serif text-h1 font-medium text-kelp tabular-nums">{data.length}</span>
          <span class="text-xs uppercase tracking-wider text-text-muted mt-1">reviews</span>
        </div>
      </div>
    </section>

    <EditorsPicks locale={locale} picks={picks} />
    <FilterBar locale={locale} data={data} />
    <ReviewTable locale={locale} data={data} />
  </main>

  <Footer locale={locale} />
</Layout>
