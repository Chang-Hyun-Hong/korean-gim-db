---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations } from '../../i18n/utils';

const locale = 'ko' as const;
const t = useTranslations(locale);
---
<Layout title={t('about.title')} description={t('about.placeholder_meta')} lang={locale}>
  <Header locale={locale} />
  <main class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="font-medium text-text-primary mb-4" style="font-size: var(--text-h1);">{t('about.title')}</h1>
    <p class="text-text-secondary">{t('about.placeholder')}</p>
  </main>
  <Footer locale={locale} />
</Layout>
