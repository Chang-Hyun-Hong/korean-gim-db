---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { useTranslations } from '../../../i18n/utils';

const locale = 'ko' as const;
const all = await getCollection('articles', (e) => e.id.startsWith(`${locale}/`));
const sorted = all.sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const t = useTranslations(locale);
---
<Layout title={t('articles.index_title')} description={t('articles.meta_description')} lang={locale}>
  <Header locale={locale} />
  <main id="main" tabindex="-1" class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="font-serif text-h1 text-text-primary mb-8">{t('articles.index_title')}</h1>
    <div class="flex gap-2 mb-12 flex-wrap" role="group" aria-label={t('articles.index_title')} data-filter>
      <button type="button" data-cat="all" aria-pressed="true" class="filter-btn active">{t('articles.filter_all')}</button>
      <button type="button" data-cat="news" aria-pressed="false" class="filter-btn">{t('articles.cat_news')}</button>
      <button type="button" data-cat="recipe" aria-pressed="false" class="filter-btn">{t('articles.cat_recipe')}</button>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      {sorted.map((e) => <ArticleCard entry={e} locale={locale} />)}
    </div>
    <p data-empty-state hidden class="py-16 text-center text-text-secondary">{t('articles.empty')}</p>
  </main>
  <Footer locale={locale} />
</Layout>
<script>
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
  document.querySelectorAll<HTMLButtonElement>('[data-filter] [data-cat]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-cat');
      document
        .querySelectorAll<HTMLButtonElement>('[data-filter] [data-cat]')
        .forEach((b) => {
          const on = b === btn;
          b.classList.toggle('active', on);
          b.setAttribute('aria-pressed', String(on));
        });
      let shown = 0;
      cards.forEach((c) => {
        const hide = cat !== 'all' && c.getAttribute('data-category') !== cat;
        c.classList.toggle('hidden', hide);
        if (!hide) shown++;
      });
      // 해당 분류에 글이 없으면 빈 그리드 대신 안내를 보여준다
      if (emptyState) emptyState.hidden = shown > 0;
    });
  });
</script>
