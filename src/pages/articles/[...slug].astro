---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  const all = await getCollection('articles');
  return all
    .filter((e) => e.id.startsWith('en/'))
    .map((e) => ({
      params: { slug: e.id.replace(/^en\//, '') },
      props: { entry: e },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const locale = 'en' as const;
const t = useTranslations(locale);
const dateStr = entry.data.publishedAt.toISOString().slice(0, 10);
const isRecipe = entry.data.category === 'recipe';

const baseSchema = {
  '@context': 'https://schema.org',
  headline: entry.data.title,
  name: entry.data.title,
  description: entry.data.description,
  inLanguage: 'en-US',
  author: { '@type': 'Person', name: entry.data.author },
  datePublished: entry.data.publishedAt.toISOString(),
  ...(entry.data.updatedAt && { dateModified: entry.data.updatedAt.toISOString() }),
};

const schema = isRecipe
  ? {
      ...baseSchema,
      '@type': 'Recipe',
      ...(entry.data.cookTime && { cookTime: `PT${entry.data.cookTime}M`, totalTime: `PT${entry.data.cookTime}M` }),
      ...(entry.data.servings && { recipeYield: `${entry.data.servings}` }),
      ...(entry.data.tags?.length && { keywords: entry.data.tags.join(', ') }),
      recipeCategory: 'Korean',
      recipeCuisine: 'Korean',
    }
  : { ...baseSchema, '@type': 'Article' };

const difficultyLabel = entry.data.difficulty ? t(`recipe.${entry.data.difficulty}`) : '';
---
<Layout
  title={entry.data.title}
  description={entry.data.description}
  lang={locale}
  type="article"
>
  <JsonLd slot="head" schema={schema} />
  <Header locale={locale} />
  <article class="max-w-3xl mx-auto px-6 py-16">
    <p class="text-text-muted text-sm uppercase tracking-wide mb-3">
      {entry.data.category} · {dateStr}
    </p>
    <h1 class="font-serif text-text-primary mb-4" style="font-size: var(--text-h1); line-height: var(--text-h1--line-height);">{entry.data.title}</h1>
    <p class="text-text-secondary text-lg mb-8">{entry.data.description}</p>

    {isRecipe && (entry.data.cookTime || entry.data.servings || entry.data.difficulty) && (
      <dl class="grid grid-cols-3 gap-4 mb-12 p-6 rounded-md bg-seafoam-light/40 border border-kelp/20">
        {entry.data.cookTime && (
          <div>
            <dt class="text-text-muted text-xs uppercase tracking-wide mb-1">{t('recipe.cook_time')}</dt>
            <dd class="text-text-primary font-medium">{entry.data.cookTime}{t('recipe.minutes_suffix')}</dd>
          </div>
        )}
        {entry.data.servings && (
          <div>
            <dt class="text-text-muted text-xs uppercase tracking-wide mb-1">{t('recipe.servings')}</dt>
            <dd class="text-text-primary font-medium">{entry.data.servings}{t('recipe.servings_suffix')}</dd>
          </div>
        )}
        {entry.data.difficulty && (
          <div>
            <dt class="text-text-muted text-xs uppercase tracking-wide mb-1">{t('recipe.difficulty')}</dt>
            <dd class="text-text-primary font-medium">{difficultyLabel}</dd>
          </div>
        )}
      </dl>
    )}

    <div class="prose">
      <Content />
    </div>
  </article>
  <Footer locale={locale} />
</Layout>
